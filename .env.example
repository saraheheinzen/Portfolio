# Copy to .env and fill in. Never commit .env.

# Required for LLM Clippy (dev + vite preview). Without this, Clippy uses the local fallback.
OPENAI_API_KEY=

# Optional — OpenAI-compatible endpoint (OpenAI, Azure OpenAI, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Shared password that unlocks locked case studies (client-side sessionStorage).
# Soft gate for sharing with recruiters — not real security (value ships in the JS bundle).
VITE_CASE_STUDY_PASSWORD=
